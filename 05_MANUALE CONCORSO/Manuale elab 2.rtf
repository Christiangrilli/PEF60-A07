\f2  
\f1\fs22\fsmilli11010 \cf2 affetti da Disabilit\'e0;\

\f3\fs28\fsmilli14010 \cf3 \uc0\u61607 
\f2  
\f1\fs22\fsmilli11010 \cf2 DSA;\

\f3\fs28\fsmilli14010 \cf3 \uc0\u61607 
\f2  
\f1\fs22\fsmilli11010 \cf2 stranieri;\

\f3\fs28\fsmilli14010 \cf3 \uc0\u61607 
\f2  
\f1\fs22\fsmilli11010 \cf2 con svantaggio socioculturale ed economico;\

\f3\fs28\fsmilli14010 \cf3 \uc0\u61607 
\f2  
\f1\fs22\fsmilli11010 \cf2 con disturbi evolutivi.\

